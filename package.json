{
  "name": "pixelweb",
  "version": "0.1.0",
  "private": true,
  "description": "A visual, teaching-oriented workbench that sits on top of coding agents such as OpenCode.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pixelweb/server & npm run dev --workspace=@pixelweb/web & wait",
    "dev:server": "npm run dev --workspace=@pixelweb/server",
    "dev:web": "npm run dev --workspace=@pixelweb/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node packages/server/dist/index.js",
    "pm2:start": "npm run build && pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "dev:mock": "npm run dev:mock --workspace=@pixelweb/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "^4.3.2"
    }
  }
}
